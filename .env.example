# Copiar este archivo como .env y completar con valores reales.
# El archivo .env NUNCA se sube al repositorio.

# API del BCRA (pública, no requiere token)
BCRA_API_URL=https://api.bcra.gob.ar/estadisticascambiarias/v1.0

# Redshift (se usa en la etapa de carga)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_SCHEMA=